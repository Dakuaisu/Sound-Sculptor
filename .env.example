# =============================================================================
# Sound Sculptor — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# --- Flask ---
SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=development
# Set to 1 when served over HTTPS
SESSION_COOKIE_SECURE=0

# --- Spotify OAuth ---
# Register at https://developer.spotify.com/dashboard
CLIENT_ID=your_spotify_client_id
CLIENT_SECRET=your_spotify_client_secret

# --- OpenAI (optional, for AI playlist generation) ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_COMPLETION_TOKENS=1000
# Per client IP, on /api/ai/generate (flask-limiter syntax)
AI_RATE_LIMIT=5 per minute;50 per day

# --- URLs ---
# Frontend URL (where users are redirected after OAuth)
FRONTEND_URL=http://127.0.0.1:5173

# OAuth callback; register exactly this in the Spotify dashboard.
# Spotify rejects "localhost": use 127.0.0.1 locally and HTTPS elsewhere.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/callback

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Docker production overrides ---
# When running with docker-compose, these are auto-set:
# FRONTEND_URL=http://127.0.0.1
# SPOTIFY_REDIRECT_URI=http://127.0.0.1/api/callback
# CORS_ORIGINS=http://127.0.0.1
